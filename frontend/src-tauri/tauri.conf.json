{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "DualConnect",
    "version": "1.4.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "notification": {
        "all": true
      },
      "window": {
        "all": true
      },
      "clipboard": {
        "writeText": true
      },
      "os": {
        "all": true
      },
      "protocol": {
        "asset": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Public.app-category.communication",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.dualconnect.desktop",
      "longDescription": "",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; connect-src 'self' https://api.dualconnect.internal ws://api.dualconnect.internal wss://api.dualconnect.internal;"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.dualconnect.internal/v1/updates/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dGhpcy1pcy1hLW1vY2stcHVibGljLWtleQ=="
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "DualConnect",
        "width": 1200,
        "center": true,
        "visible": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}
