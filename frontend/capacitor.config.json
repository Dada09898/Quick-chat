{
  "appId": "com.enterprise.dualconnect",
  "appName": "DualConnect",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://api.dualconnect.internal",
    "cleartext": false,
    "allowNavigation": [
      "api.dualconnect.internal"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#111827",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    }
  }
}
